    {
      "id": "sql_node_ISa9x6UG",
      "type": "sql-node",
      "data": {
        "database_id": "",
        "sql": "",
        "params": {},
        "title": "Run SQL",
        "isValidator": true,
        "nodeName": "Run SQL",
        "name": "Run SQL",
        "script": {
          "type": "sql",
          "code": "SELECT \n    i.id,\n    i.material_code,\n    i.material_name,\n    i.material_desc,\n    i.based_uom,\n    buom.uom_name AS based_uom_name,\n    i.item_category,\n    mc.mat_cat_name AS item_category_name,\n    i.material_costing_method,\n    REPLACE(REPLACE(REPLACE(i.business_scope, '[', ''), ']', ''), '\"', '') AS business_scope_values,\n    i.table_cust_item_access,\n    GROUP_CONCAT(DISTINCT iaccess.customer_id ORDER BY iaccess.customer_id SEPARATOR ', ') AS customer_ids,\n    GROUP_CONCAT(DISTINCT iaccess.cust_price_tag_id ORDER BY iaccess.cust_price_tag_id SEPARATOR ', ') AS cust_price_tag_ids,\n    GROUP_CONCAT(DISTINCT iaccess.id ORDER BY iaccess.id SEPARATOR ', ') AS access_ids,\n    i.net_weight,\n    i.organization_id,\n    COALESCE((\n        SELECT SUM(ib2.unrestricted_qty)\n        FROM item_balance ib2\n        WHERE ib2.material_id = i.id\n          AND ib2.organization_id = i.organization_id\n          AND ib2.is_deleted = 0\n    ), 0) AS total_unrestricted_qty\nFROM item i\nLEFT JOIN unit_of_measurement buom \n    ON i.based_uom = buom.id\nLEFT JOIN material_category mc \n    ON i.item_category = mc.id\nLEFT JOIN item_k5mbon7z_sub iaccess \n    ON i.id = iaccess.item_id\nWHERE i.is_deleted = 0\n  AND i.is_active = 1\n  AND i.organization_id = '{{global:firstLvDeptId}}'\n  AND REPLACE(REPLACE(REPLACE(i.business_scope, '[', ''), ']', ''), '\"', '') LIKE '%1%'\nGROUP BY \n    i.id,\n    i.material_code,\n    i.material_name,\n    i.material_desc,\n    i.based_uom,\n    buom.uom_name,\n    i.item_category,\n    i.material_costing_method,\n    mc.mat_cat_name,\n    i.business_scope,\n    i.organization_id\nHAVING \n    access_ids IS NULL\n    OR \n    (\n        (COALESCE('{{workflowparams:customer_id}}', '') = '' OR FIND_IN_SET('{{workflowparams:customer_id}}', customer_ids) > 0)\n        OR \n        (COALESCE('{{workflowparams:price_tag_id}}', '') = '' OR FIND_IN_SET('{{workflowparams:price_tag_id}}', cust_price_tag_ids) > 0)\n    )\nORDER BY i.id;"
        },
