      {
        "key": "51f8p6pa",
        "name": "onChange_plant_get_data",
        "func": "(async () => {\nconst plantID = this.getValue('plant_id');\nconst resPlantTransferSetup = await db.collection('plant_transfer_setup')\n  .where({plant_id: plantID})\n  .get()\n  if (!resPlantTransferSetup || resPlantTransferSetup.data.length === 0) {\n    this.setData({\n    plant_transfer_setup_id: \"\",\n    auto_cn: 0,\n    batch_type: 0,\n    generate_new_batch: 0\n    \n  })\n    return\n  }\n  \n  this.setData({\n    plant_transfer_setup_id: resPlantTransferSetup.data[0].id,\n    auto_cn: resPlantTransferSetup.data[0].picking_required,\n      batch_type: resPlantTransferSetup.data[0].putaway_required,\n      generate_new_batch: resPlantTransferSetup.data[0].generate_new_batch\n    \n  })\n  }\n  )();",
        "type": "js"
      },
      {
        "key": "3saavmmv",
        "name": "onClick_save",
        "func": "const closeDialog = () => {\n  if (this.parentGenerateForm) {\n    this.parentGenerateForm.$refs.SuPageDialogRef.hide();\n    this.parentGenerateForm.refresh();\n    this.hideLoading();\n  }\n};\n\n(async () => {\n  try {\n    const data = this.getValues();\n\n    let entry = data;\n\n    if (entry.sales_return_setup_id !== \"\") {\n      await db\n        .collection(\"sales_return_setup\")\n        .doc(entry.sales_return_setup_id)\n        .update(entry);\n\n      const plantList = await db\n        .collection(\"blade_dept\")\n        .where({ parent_id: entry.organization_id })\n        .get()\n        .then((res) => {\n          return res.data.map((item) => item.id);\n        });\n\n      if (plantList.length === 0) {\n        // No plants exist, use organization_id as plant_id\n        const srSetup = await db\n          .collection(\"sales_return_setup\")\n          .where({\n            plant_id: entry.organization_id,\n            organization_id: entry.organization_id,\n          })\n          .get();\n        if (srSetup.data.length > 0) {\n          await db\n            .collection(\"sales_return_setup\")\n            .doc(srSetup.data[0].id)\n            .update(entry);\n        }\n      } else {\n        // Plants exist, update for each plant\n        for (const plant of plantList) {\n          const srSetup = await db\n            .collection(\"sales_return_setup\")\n            .where({ plant_id: plant, organization_id: entry.organization_id })\n            .get();\n          if (srSetup.data.length > 0) {\n            await db\n              .collection(\"sales_return_setup\")\n              .doc(srSetup.data[0].id)\n              .update({...entry, plant_id: plant});\n          }\n        }\n      }\n    } else {\n      await db.collection(\"sales_return_setup\").add(entry);\n\n      const plantList = await db\n        .collection(\"blade_dept\")\n        .where({ parent_id: entry.organization_id })\n        .get()\n        .then((res) => {\n          return res.data.map((item) => item.id);\n        });\n\n      if (plantList.length === 0) {\n        // No plants exist, use organization_id as plant_id\n        await db.collection(\"sales_return_setup\").add({\n          ...entry,\n          plant_id: entry.organization_id,\n          organization_id: entry.organization_id,\n        });\n      } else {\n        // Plants exist, create for each plant\n        for (const plant of plantList) {\n          await db.collection(\"sales_return_setup\").add({\n            ...entry,\n            plant_id: plant,\n            organization_id: entry.organization_id,\n          });\n        }\n      }\n    }\n\n    closeDialog();\n    this.$message.success(\"Update Sucessfully\");\n  } catch (error) {\n    console.error(error);\n    this.$message.error(error.message || \"An error occurred\");\n  }\n})();\n",
        "type": "js"
      },
      {
