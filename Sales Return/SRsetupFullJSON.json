        "func": "(async () => {\n  try {\n    let organizationId = this.getVarGlobal(\"deptParentId\");\n    if (organizationId === \"0\") {\n      organizationId = this.getVarSystem(\"deptIds\").split(\",\")[0];\n    }\n\n    console.log(\"Organization ID:\", organizationId);\n\n    await this.setData({ organization_id: organizationId });\n\n    const resSRSetup = await db\n      .collection(\"sales_return_setup\")\n      .where({ organization_id: organizationId })\n      .get();\n\n    if (!resSRSetup || resSRSetup.data.length === 0) {\n      this.setData({\n        sales_return_setup_id: \"\",\n        auto_cn: 0,\n        trigger_by: \"Sales Return\",\n        generate_new_batch: 0,\n      });\n      return;\n    }\n\n    this.setData({\n      sales_return_setup_id: resSRSetup.data[0].id,\n      auto_cn: resSRSetup.data[0].auto_cn,\n      trigger_by: resSRSetup.data[0].trigger_by,\n      generate_new_batch: resSRSetup.data[0].generate_new_batch,\n    });\n  } catch (error) {\n    console.error(error);\n    this.$message.error(error.message || \"An error occurred\");\n  }\n})();\n",
        "type": "js"
      },
