   "name": "expected_return_qty",
   "persistField": true,
   "precision": 3,
   "primaryKey": false,
   "title": "Expected Return Quantity",
   "validator": "// A subform row is identified by its fm_key, not by where it sits: an item\n// under an item bundle is not a row of table_sr at all, so the position in the\n// field path does not reach it. The row is found by walking the tree instead,\n// falling back to position for a row the platform has not keyed yet.\nconst rowKey = arguments[0].field.split(\".\")[1];\nconst rows = this.getValue(\"table_sr\") || [];\n\nconst resolveRow = (key) => {\n  for (const row of rows) {\n    if (row && String(row.fm_key) === String(key)) return row;\n\n    for (const child of Array.isArray(row && row.children) ? row.children : []) {\n      if (child && String(child.fm_key) === String(key)) return child;\n    }\n  }\n\n  return rows[key] || null;\n};\n\nconst targetRow = resolveRow(rowKey) || {};\nconst toReturnedQty = targetRow.to_returned_qty;\n\nif (value > toReturnedQty) {\n  callback(\"Exceeds the returnable quantity\");\n} else {\n  callback();\n}"
  },
