    {
      "id": "code_map_cancel",
      "type": "code-node",
      "data": {
        "language": "javascript",
        "code": "",
        "timeout": 30000,
        "title": "Map Latest PO/GR",
        "isValidator": true,
        "nodeName": "Map Latest PO/GR",
        "name": "Map Latest PO/GR",
        "script": {
          "type": "javascript",
          "code": "const data = {{node:get_pi_data.data.data}};\nconst poList = {{node:search_po_list.data.data}} || [];\nconst grList = {{node:search_gr_list.data.data}} || [];\n\nconst round8 = (value) => Math.round((parseFloat(value) || 0) * 100000000) / 100000000;\nconst qtyStr = (value) => Math.max(0, round8(value)).toFixed(8);\n\n// table_pi, table_po and table_gr are trees: an item bundle is ONE line with its\n// items under `children`. A bundle's items are invoiced lines in their own right\n// -- each has a purchase order line of its own -- so cancelling has to reverse\n// them too. Read off the top level alone, their invoice_qty stayed on the\n// purchase order and the goods receiving for good. A row with no `children`\n// yields just itself, so this is a no-op without bundles and on a flat read-back.\nconst flattenRows = (rows) => {\n  const flat = [];\n\n  for (const row of rows || []) {\n    flat.push(row);\n\n    for (const child of Array.isArray(row.children) ? row.children : []) {\n      flat.push(child);\n    }\n  }\n\n  return flat;\n};\n\n// A bundle's items carry the bundle id and an item of their own. Read back flat\n// they sit at the top level, so this catches them in either shape.\nconst isBundleComponent = (row) =>\n  Boolean(row.item_bundle_id) && Boolean(row.material_id || row.item_id);\n\nconst processItems = (items, tablePi, docId, docIdKey, piLineIdKey, qtyKey, reversePosted) => {\n  const filteredPI = flattenRows(tablePi).filter((item) => item[docIdKey] === docId);\n\n  // Each entry remembers the position of its bundle line (-1 when it is not in a\n  // bundle).\n  const flat = [];\n  for (const row of items || []) {\n    const position = flat.length;\n    flat.push({ row, parent: -1, nested: false });\n\n    for (const child of Array.isArray(row.children) ? row.children : []) {\n      flat.push({ row: child, parent: position, nested: true });\n    }\n  }\n\n  const applied = flat.map(({ row, parent, nested }) => {\n    const matchedPI = filteredPI.find((pi) => pi[piLineIdKey] === row.id);\n    if (!matchedPI) return { row: { ...row }, parent, nested };\n\n    const piQty = round8(matchedPI.invoice_qty);\n    const newInvoiceQty = Math.max(0, round8(round8(row.invoice_qty) - piQty));\n    const updatedItem = { ...row, invoice_qty: newInvoiceQty };\n\n    if (reversePosted) {\n      updatedItem.posted_qty = Math.max(0, round8(round8(row.posted_qty) - piQty));\n    }\n\n    if (newInvoiceQty > 0) {\n      updatedItem.pi_status = \"Partially Invoiced\";\n      if (newInvoiceQty >= round8(row[qtyKey] || 0)) {\n        updatedItem.pi_status = \"Fully Invoiced\";\n      }\n    } else {\n      updatedItem.pi_status = \"Cancelled\";\n    }\n\n    return { row: updatedItem, parent, nested };\n  });\n\n  // A bundle's items carry the bundle line's status, the same way they are given\n  // it on the way in.\n  for (const entry of applied) {\n    if (entry.parent === -1) continue;\n\n    entry.row.pi_status = applied[entry.parent].row.pi_status;\n  }\n\n  // Only the counters of changed lines go back: a whole-row write re-validates every other column.\n  const lineUpdates = [];\n  for (const [index, entry] of applied.entries()) {\n    const before = flat[index].row;\n    const after = entry.row;\n\n    if (\n      round8(after.invoice_qty) === round8(before.invoice_qty) &&\n      (!reversePosted || round8(after.posted_qty) === round8(before.posted_qty)) &&\n      String(after.pi_status || \"\") === String(before.pi_status || \"\")\n    ) {\n      continue;\n    }\n\n    const update = { id: after.id, invoice_qty: qtyStr(after.invoice_qty), pi_status: after.pi_status || \"\" };\n    if (reversePosted) update.posted_qty = qtyStr(after.posted_qty);\n    lineUpdates.push(update);\n  }\n\n  // Only a bundle line counts as a line: its items cannot be invoiced apart from it.\n  const countableItems = applied\n    .filter((e) => e.parent === -1 && !isBundleComponent(e.row))\n    .map((e) => e.row)\n    .filter((item) => item.parent_or_child !== \"Child\");\n  const totalItems = countableItems.length;\n  const partiallyInvoicedItems = countableItems.filter((item) => item.pi_status === \"Partially Invoiced\").length;\n  const fullyInvoicedItems = countableItems.filter((item) => item.pi_status === \"Fully Invoiced\").length;\n\n  const allItemsComplete = fullyInvoicedItems === totalItems;\n  const anyItemProcessing = partiallyInvoicedItems > 0 || fullyInvoicedItems > 0;\n  const newPIStatus = anyItemProcessing\n    ? allItemsComplete\n      ? \"Fully Invoiced\"\n      : \"Partially Invoiced\"\n    : \"Cancelled\";\n\n  return { lineUpdates, newPIStatus };\n};\n\nconst flag = (rows) => (rows.length > 0 ? 1 : 0);\n\n// A Draft or already-Cancelled PI has nothing applied to reverse; reversing it would eat other invoices' quantities.\nconst storedStatus = data ? String(data.pi_status || \"\") : \"\";\nif (!data || storedStatus === \"Draft\" || storedStatus === \"Cancelled\") {\n  return {\n    blocked: 1,\n    message: data\n      ? `Purchase Invoice ${data.purchase_invoice_no} is ${storedStatus}, so there is nothing to cancel.`\n      : \"Purchase Invoice not found.\",\n    poHeaders: [],\n    hasPoHeaders: 0,\n    poLines: [],\n    hasPoLines: 0,\n    grHeaders: [],\n    hasGrHeaders: 0,\n    grLines: [],\n    hasGrLines: 0,\n    updatedPI: {},\n  };\n}\n\nconst poIds = Array.isArray(data.po_id) ? data.po_id : [data.po_id];\nconst poHeaders = [];\nconst poLines = [];\nfor (const poID of poIds) {\n  const poData = poList.find((po) => po.id === poID);\n  if (!poData) continue;\n  const poItems = poData.table_po || [];\n  const { lineUpdates, newPIStatus } = processItems(poItems, data.table_pi, poData.id, \"line_po_id\", \"po_line_id\", \"quantity\", true);\n  poHeaders.push({ id: poData.id, pi_status: newPIStatus });\n  poLines.push(...lineUpdates);\n}\n\nconst grHeaders = [];\nconst grLines = [];\nif (data.gr_id && data.gr_id.length > 0) {\n  const grIds = Array.isArray(data.gr_id) ? data.gr_id : [data.gr_id];\n  for (const grID of grIds) {\n    const grData = grList.find((gr) => gr.id === grID);\n    if (!grData) continue;\n    const grItems = grData.table_gr || [];\n    const { lineUpdates, newPIStatus } = processItems(grItems, data.table_pi, grData.id, \"line_gr_id\", \"gr_line_id\", \"received_qty\", false);\n    grHeaders.push({ id: grData.id, pi_status: newPIStatus });\n    grLines.push(...lineUpdates);\n  }\n}\n\nreturn {\n  blocked: 0,\n  message: \"\",\n  poHeaders,\n  hasPoHeaders: flag(poHeaders),\n  poLines,\n  hasPoLines: flag(poLines),\n  grHeaders,\n  hasGrHeaders: flag(grHeaders),\n  grLines,\n  hasGrLines: flag(grLines),\n  updatedPI: {\n    id: data.id,\n    pi_status: \"Cancelled\",\n    purchase_invoice_no: data.purchase_invoice_no + \"-Cancelled\"\n  }\n};"
        },
        "response_json": [
