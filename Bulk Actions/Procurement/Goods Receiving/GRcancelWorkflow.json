    {
      "id": "sql_node_CcPoStatus",
      "type": "sql-node",
      "data": {
        "database_id": "",
        "sql": "",
        "params": {},
        "title": "This GR's POs: lines as they are now",
        "isValidator": true,
        "nodeName": "This GR's POs: lines as they are now",
        "name": "This GR's POs: lines as they are now",
        "script": {
          "type": "sql",
          "code": "SELECT CAST(h.id AS CHAR) AS po_id,\n       SUM(COALESCE(p.created_received_qty, 0) > 0) AS reserved,\n       SUM(NOT (COALESCE(p.item_bundle_id, 0) <> 0 AND COALESCE(p.item_id, '') <> '')) AS countable,\n       SUM(NOT (COALESCE(p.item_bundle_id, 0) <> 0 AND COALESCE(p.item_id, '') <> '')\n           AND COALESCE(p.received_qty, 0) > 0) AS partially,\n       SUM(NOT (COALESCE(p.item_bundle_id, 0) <> 0 AND COALESCE(p.item_id, '') <> '')\n           AND COALESCE(p.received_qty, 0) > 0 AND p.received_qty >= COALESCE(p.quantity, 0)) AS fully\n  FROM JSON_TABLE(CONCAT('[', '{{node:code_node_CcPlan.data.poCsv}}', ']'), '$[*]' COLUMNS (pid BIGINT PATH '$')) sel\n  JOIN purchase_order h ON h.id = sel.pid AND h.is_deleted = 0\n  JOIN purchase_order_2ukyuanr_sub p ON p.purchase_order_id = h.id AND p.is_deleted = 0\n WHERE h.tenant_id = '{{system:tenantId}}'\n GROUP BY h.id"
        },
