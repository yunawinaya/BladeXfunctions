    {
      "id": "code_reversals",
      "type": "code-node",
      "data": {
        "language": "javascript",
        "code": "",
        "timeout": 30000,
        "title": "Compute PO Reversals",
        "isValidator": true,
        "nodeName": "Compute PO Reversals",
        "name": "Compute PO Reversals",
        "script": {
          "type": "javascript",
          "code": "const grRaw = {{node:get_gr.data.data}};\nconst gr = Array.isArray(grRaw) ? grRaw[0] : grRaw;\nconst poList = {{node:search_po.data.data}} || [];\n// table_gr and table_po are trees: an item bundle is ONE row with its items under\n// `children`. A bundle's items each reserved against a purchase order line of\n// their own, so each has to be released again -- read off the top level alone,\n// their share of created_received_qty stayed on the purchase order for good. A\n// row with no `children` yields just itself, so this is a no-op on a document\n// with no bundles and on one read back already flat.\nconst flattenRows = (rows) => {\n  const flat = [];\n\n  for (const row of rows || []) {\n    flat.push(row);\n\n    for (const child of Array.isArray(row.children) ? row.children : []) {\n      flat.push(child);\n    }\n  }\n\n  return flat;\n};\n\n// A bundle's items carry the bundle id and an item of their own. Read back flat\n// they sit at the top level, so this catches them in either shape.\nconst isBundleComponent = (row) =>\n  Boolean(row.item_bundle_id) && Boolean(row.item_id);\n\nconst grLines = flattenRows(gr && gr.table_gr);\nconst grNo = {{workflowparams:gr_no}} || \"\";\n\n// Total qty to reverse per PO line item.\nconst reversals = {};\nfor (const line of grLines) {\n  // Split-parent rows sum their children; counting them would double-reverse.\n  if (line.is_split === \"Yes\" && line.parent_or_child === \"Parent\") {\n    continue;\n  }\n  const lineId = line.po_line_item_id;\n  reversals[lineId] = (reversals[lineId] || 0) + parseFloat(line.received_qty || 0);\n}\n\nconst poUpdates = poList.map((po) => {\n  // Each entry remembers the position of its bundle line (-1 when it is not in a\n  // bundle) so what is written back keeps the shape it arrived in.\n  const flat = [];\n  for (const row of po.table_po || []) {\n    const position = flat.length;\n    flat.push({ row, parent: -1, nested: false });\n\n    for (const child of Array.isArray(row.children) ? row.children : []) {\n      flat.push({ row: child, parent: position, nested: true });\n    }\n  }\n\n  const applied = flat.map(({ row, parent, nested }) => {\n    const rev = reversals[row.id] || 0;\n    if (rev > 0) {\n      const cur = parseFloat(row.created_received_qty || 0);\n      // toFixed STRING: raw float output breaks the DB multipleOf check.\n      return { row: Object.assign({}, row, { created_received_qty: Math.max(0, cur - rev).toFixed(3) }), parent, nested };\n    }\n    return { row: Object.assign({}, row), parent, nested };\n  });\n\n  // Written back in the shape it arrived in.\n  const items = [];\n  for (const [index, entry] of applied.entries()) {\n    if (entry.nested) continue;\n\n    const children = applied\n      .filter((candidate) => candidate.nested && candidate.parent === index)\n      .map((candidate) => candidate.row);\n\n    if (children.length > 0) {\n      items.push(Object.assign({}, entry.row, { children }));\n    } else if (Array.isArray(entry.row.children)) {\n      items.push(Object.assign({}, entry.row, { children: [] }));\n    } else {\n      items.push(entry.row);\n    }\n  }\n\n  // Any line at all can still hold a reservation, a bundle's items included.\n  const hasRemainingCreated = applied.some((e) => (parseFloat(e.row.created_received_qty) || 0) > 0);\n\n  // Received status is decided on the bundle line, never on its items -- the same\n  // rule the forward path uses when it updates the purchase order after a receipt.\n  const countable = applied.filter((e) => e.parent === -1 && !isBundleComponent(e.row)).map((e) => e.row);\n  const allCompleted = countable.every((i) => (parseFloat(i.received_qty) || 0) >= (parseFloat(i.quantity) || 0));\n  const anyProcessing = countable.some((i) => (parseFloat(i.received_qty) || 0) > 0 && (parseFloat(i.received_qty) || 0) < (parseFloat(i.quantity) || 0));\n\n  let grStatus;\n  if (hasRemainingCreated) {\n    grStatus = \"Created\";\n  } else if (allCompleted) {\n    grStatus = \"Fully Received\";\n  } else if (anyProcessing) {\n    grStatus = \"Partially Received\";\n  } else {\n    grStatus = \"Cancelled\";\n  }\n\n  return { po_id: po.id, table_po: items, gr_status: grStatus };\n});\n\nreturn {\n  poUpdates: poUpdates,\n  cancelledGrNo: grNo.endsWith(\"-Cancelled\") ? grNo : grNo + \"-Cancelled\"\n};"
        },
