      "id": "sql_node_CcLines",
      "type": "sql-node",
      "data": {
        "database_id": "",
        "sql": "",
        "params": {},
        "title": "This GR's PO lines: reserved qty + fresh created_received_qty",
        "isValidator": true,
        "nodeName": "This GR's PO lines: reserved qty + fresh created_received_qty",
        "name": "This GR's PO lines: reserved qty + fresh created_received_qty",
        "script": {
          "type": "sql",
          "code": "SELECT CAST(p.id AS CHAR) AS id, CAST(p.purchase_order_id AS CHAR) AS po_id,\n       p.created_received_qty, SUM(l.received_qty) AS rev\n  FROM goods_receiving_eg6l4ywi_sub l\n  JOIN purchase_order_2ukyuanr_sub p ON p.id = l.po_line_item_id AND p.is_deleted = 0\n  JOIN purchase_order h ON h.id = p.purchase_order_id AND h.is_deleted = 0\n WHERE l.goods_receiving_id IN ({{node:code_node_CcGuardKey.data.idsCsv}})\n   AND l.tenant_id = '{{system:tenantId}}'\n   AND l.is_deleted = 0\n   AND NOT (COALESCE(l.is_split, '') = 'Yes' AND COALESCE(l.parent_or_child, '') = 'Parent')\n GROUP BY p.id, p.purchase_order_id, p.created_received_qty"
        },
