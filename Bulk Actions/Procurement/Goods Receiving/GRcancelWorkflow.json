    {
      "id": "code_node_CcPoHdr",
      "type": "code-node",
      "data": {
        "language": "javascript",
        "code": "",
        "timeout": 30000,
        "title": "PO gr_status from its lines",
        "isValidator": true,
        "nodeName": "PO gr_status from its lines",
        "name": "PO gr_status from its lines",
        "script": {
          "type": "javascript",
          "code": "// some lines received + the rest untouched -> Partially Received (it used to end Cancelled)\n// counted as GOODS_RECEIVING does (a bundle's items are not counted, the bundle line is)\nconst poGrStatus = (r) => {\n  const n = (v) => Number(v) || 0;\n  if (n(r.reserved) > 0) return \"Created\";\n  if (n(r.countable) > 0 && n(r.fully) === n(r.countable)) return \"Fully Received\";\n  if (n(r.partially) > 0) return \"Partially Received\";\n  return \"Cancelled\";\n};\nconst rows = [{{node:sql_node_CcPoStatus.data}}][0] || [];\nconst headers = [];\nfor (const r of Array.isArray(rows) ? rows : [rows]) {\n  const id = String(r.po_id || \"\");\n  if (!/^[0-9]{1,20}$/.test(id)) continue;\n  headers.push({ id, gr_status: poGrStatus(r) });\n}\nreturn { headers, hasHeaders: headers.length > 0 ? \"YES\" : \"NO\" };"
        },
