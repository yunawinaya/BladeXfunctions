  "received_qty": {
   "bsonType": "decimal",
   "component": {
    "name": "su-fm-enhanced-number-input"
   },
   "dataIdentifier": false,
   "defaultValue": 0,
   "description": "Received Qty",
   "desensitization": false,
   "encryptedKey": false,
   "errorMessage": {},
   "historyKey": false,
   "immutableKey": false,
   "isRequired": true,
   "key": "c0en0hs9",
   "maxLength": 65,
   "name": "received_qty",
   "persistField": true,
   "precision": 3,
   "primaryKey": false,
   "title": "Received Qty",
   "validator": "// A subform row is identified by its fm_key, not by where it sits: an item\n// under an item bundle is not a row of table_srr at all, so the position in the\n// field path does not reach it. The row is found by walking the tree instead,\n// falling back to position for a row the platform has not keyed yet.\nconst rowKey = arguments[0].field.split(\".\")[1];\nconst tableSRR = this.getValue(\"table_srr\") || [];\n\nconst childrenOf = (row) => (Array.isArray(row.children) ? row.children : []);\n\nconst resolveRow = (key) => {\n  for (const row of tableSRR) {\n    if (row && String(row.fm_key) === String(key)) return row;\n\n    for (const child of childrenOf(row || {})) {\n      if (child && String(child.fm_key) === String(key)) return child;\n    }\n  }\n\n  return tableSRR[key] || null;\n};\n\nconst targetRow = resolveRow(rowKey) || {};\nlet toReturnedQty = targetRow.to_receive_qty;\nconst lineIndex = targetRow.line_index;\nconst hasParent = lineIndex ? String(lineIndex).split(\"-\") : null;\nlet cummulativeReturnedQty = 0;\n\nif (hasParent && hasParent.length > 1) {\n  const parentLineIndex = parseInt(hasParent[0]);\n\n  // The line this one sits under, found by the number it carries rather than by\n  // counting rows. Matched on the whole label, not parsed: parseInt(\"1-1\") is\n  // also 1, so an item of the bundle would be found before the bundle itself.\n  const parentRow = tableSRR.find(\n    (item) => String(item.line_index) === hasParent[0],\n  );\n\n  toReturnedQty = parentRow ? parentRow.to_receive_qty : toReturnedQty;\n\n  cummulativeReturnedQty = tableSRR.reduce((total, item) => {\n    if (parseInt(item.parent_index) === parentLineIndex) {\n      return total + (item.received_qty || 0);\n    } else {\n      return total;\n    }\n  }, 0);\n}\n\nconsole.log(\"toReturnedQty:\", toReturnedQty);\nconsole.log(\"cummulativeReturnedQty:\", cummulativeReturnedQty);\nif (cummulativeReturnedQty > toReturnedQty) {\n  callback(\"Exceeds the returnable quantity\");\n} else {\n  callback();\n}\n"
  },
