        "name": "Build Descriptions",
        "script": {
          "type": "javascript",
          "code": "const res = {{node:get_node_9kQx2Vt7.data}};\nconst customerId = {{workflowparams:customer_id}};\n\n// get-node data is a single object when count===1, an array otherwise.\nconst toArray = (r) => {\n  if (!r || !r.count || r.count <= 0) return [];\n  const dd = r.data;\n  if (Array.isArray(dd)) return dd;\n  if (dd && typeof dd === \"object\") return [dd];\n  return [];\n};\n\nconst items = toArray(res);\nconst item = items.length > 0 ? items[0] : null;\nif (!item) return { descriptions: [] };\n\n// table_cust_item_bind is a subform array stored on the Item record itself --\n// it has no collection of its own, so this single fetch is all the data access\n// needed. Bind rows store the Customer's primary id; compare as trimmed strings.\nconst wanted = customerId == null ? \"\" : String(customerId).trim();\nconst binds = Array.isArray(item.table_cust_item_bind) ? item.table_cust_item_bind : [];\n\nconst descriptions = [];\nfor (const row of binds) {\n  if (!row) continue;\n  const rowCust = row.customer_id == null ? \"\" : String(row.customer_id).trim();\n  if (!wanted || rowCust !== wanted) continue;\n  const d = row.item_desc == null ? \"\" : String(row.item_desc).trim();\n  // One customer may have several rows; skip blanks and duplicates.\n  if (d && descriptions.indexOf(d) === -1) descriptions.push(d);\n}\n\n// No customer-specific description -> fall back to the item's own description.\nif (descriptions.length === 0) {\n  const fallback = item.material_desc == null ? \"\" : String(item.material_desc).trim();\n  if (fallback) descriptions.push(fallback);\n}\n\nreturn { descriptions };"
        },
