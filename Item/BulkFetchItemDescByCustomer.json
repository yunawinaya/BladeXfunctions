        "script": {
          "type": "javascript",
          "code": "const rows = {{node:search_node_9kQx2Vt7.data.data}} || [];\nconst rawItemIds = {{workflowparams:item_id}};\nconst customerId = {{workflowparams:customer_id}};\n\n// search-node rows sit one level deeper than a get-node's, at .data.data\nconst items = Array.isArray(rows) ? rows : [];\n\nconst itemById = {};\nfor (const r of items) {\n  if (r && r.id != null) itemById[String(r.id)] = r;\n}\n\n// Accept a scalar id as well as the array form, so a caller passing a plain\n// string still works.\nlet requested = [];\nif (Array.isArray(rawItemIds)) requested = rawItemIds;\nelse if (rawItemIds != null && rawItemIds !== \"\") requested = [rawItemIds];\n\nconst wanted = customerId == null ? \"\" : String(customerId).trim();\n\n// table_cust_item_bind is a subform array stored on the Item record itself --\n// it has no collection of its own, so the single Item search above is all the\n// data access needed. Bind rows store the Customer's primary id; compare as\n// trimmed strings.\nconst buildDescriptions = (item) => {\n  const out = [];\n  if (!item) return out;\n  const binds = Array.isArray(item.table_cust_item_bind) ? item.table_cust_item_bind : [];\n  for (const row of binds) {\n    if (!row) continue;\n    const rowCust = row.customer_id == null ? \"\" : String(row.customer_id).trim();\n    if (!wanted || rowCust !== wanted) continue;\n    const d = row.item_desc == null ? \"\" : String(row.item_desc).trim();\n    // One customer may have several rows; skip blanks and duplicates.\n    if (d && out.indexOf(d) === -1) out.push(d);\n  }\n  // No customer-specific description -> fall back to the item's own description.\n  if (out.length === 0) {\n    const fallback = item.material_desc == null ? \"\" : String(item.material_desc).trim();\n    if (fallback) out.push(fallback);\n  }\n  return out;\n};\n\n// One row per REQUESTED id, in request order -- an id matching no Item still\n// gets an entry with an empty list, so callers can map by index or by id.\n// descCache keeps a repeated id from being rebuilt.\nconst descCache = {};\nconst result = [];\nfor (const raw of requested) {\n  const id = raw == null ? \"\" : String(raw).trim();\n  if (!id) {\n    result.push({ item_id: \"\", descriptions: [] });\n    continue;\n  }\n  if (!descCache[id]) descCache[id] = buildDescriptions(itemById[id]);\n  result.push({ item_id: id, descriptions: descCache[id] });\n}\n\nreturn { result };"
        },
