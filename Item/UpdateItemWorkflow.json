    {
      "id": "code_node_K2TxPuHY",
      "type": "code-node",
      "data": {
        "language": "javascript",
        "code": "",
        "timeout": 30000,
        "title": "7. Check Item",
        "isValidator": true,
        "nodeName": "7. Check Item",
        "name": "7. Check Item",
        "script": {
          "type": "javascript",
          "code": "const updatedData = {{node:code_node_h0nbfgRx.data.updatedData}};\nconst itemData = {{node:search_node_m9ws9ASy.data.data}};\nconst uomData = {{node:search_node_vNAH9LEk.data.data}};\nconst taxData = {{node:search_node_Pv9Bxnth.data.data}};\nconst uomConversionData = {{node:search_node_AkGvE8Wx.data.data}};\n\n// Use the item's value only when it parses to a real number; otherwise fall\n// back to the master (UOM conversion) value. Prevents a blank/garbage cell\n// (e.g. \"NaN\", \"abc\") from surviving the `||` and producing \"NaN\".\nconst toPrice = (primary, fallback) => {\n  let value = parseFloat(primary);\n  if (Number.isNaN(value)) value = parseFloat(fallback);\n  return Number.isNaN(value) ? \"0.0000\" : value.toFixed(4);\n};\n\nconst updatedItemData = updatedData.map((item) => {\n  const matchedItemData = itemData.find(i => i.material_code === item.material_code);\n  const matchedUOMData = uomData.find(i => i.uom_name === item.uom_name);\n  const matchedUOMConversionData = uomConversionData.find(i => i.alt_uom_id === matchedUOMData.id && i.Item_id === matchedItemData.id);\n  const matchedPurchaseTax = taxData.find(i => i.tax_code === item.purchase_tax);\n  const matchedSalesTax = taxData.find(i => i.tax_code === item.sales_tax);\n\n  return {\n    ...item,\n    id: matchedUOMConversionData ? matchedUOMConversionData.id : null,\n    purchase_unit_price: toPrice(item.purchase_unit_price, matchedUOMConversionData.purchase_unit_price),\n    sales_unit_price: toPrice(item.sales_unit_price, matchedUOMConversionData.sales_unit_price),\n    mat_purchase_tax_id: matchedPurchaseTax ? matchedPurchaseTax.id : matchedUOMConversionData.mat_purchase_tax_id,\n    purchase_max_price: toPrice(item.purchase_max_price, matchedUOMConversionData.purchase_max_price),\n    purchase_min_price: toPrice(item.purchase_min_price, matchedUOMConversionData.purchase_min_price),\n    purchase_tax_percent: item.purchase_tax_percent ?? matchedUOMConversionData.purchase_tax_percent,\n    sales_max_price: toPrice(item.sales_max_price, matchedUOMConversionData.sales_max_price),\n    sales_min_price: toPrice(item.sales_min_price, matchedUOMConversionData.sales_min_price),\n    mat_sales_tax_id: matchedSalesTax ? matchedSalesTax.id : matchedUOMConversionData.mat_sales_tax_id,\n    sales_tax_percent: item.sales_tax_percent ?? matchedUOMConversionData.sales_tax_percent,\n    sales_price_1: toPrice(item.sales_price_1, matchedUOMConversionData.sales_price_1),\n    sales_price_2: toPrice(item.sales_price_2, matchedUOMConversionData.sales_price_2),\n    sales_price_3: toPrice(item.sales_price_3, matchedUOMConversionData.sales_price_3),\n    sales_price_4: toPrice(item.sales_price_4, matchedUOMConversionData.sales_price_4),\n    sales_price_5: toPrice(item.sales_price_5, matchedUOMConversionData.sales_price_5),\n    sales_price_6: toPrice(item.sales_price_6, matchedUOMConversionData.sales_price_6),\n  }\n})\n\nconst missingUOMs = updatedItemData\n  .filter(item => !item.id)\n  .map(item => `${item.material_code} (${item.uom_name})`);\n\nif(missingUOMs.length > 0) {\n  return {\n    status: 'Failed',\n    message: `These record cannot be found: ${missingUOMs.join(', ')}`,\n    updatedItemData: missingUOMs\n  }\n}\n\nreturn {\n  status: 'Success',\n  message: 'All items validated successfully',\n  updatedItemData: updatedItemData\n}"
        },
