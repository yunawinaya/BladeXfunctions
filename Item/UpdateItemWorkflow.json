          "code": "const formData = {{workflowparams:data}};\n\nconst requiredFields = [\n  \"Item Code\",\n  \"UOM\",\n];\n\n// Get only the numeric keys (actual data rows)\nconst updateFile = formData.dialog_update.update_file;\nconst numericKeys = Object.keys(updateFile).filter(\n  (key) => !isNaN(parseInt(key)),\n);\n\nif (numericKeys.length === 0) {\n  return {\n    isValid: false,\n    message: \"No valid numeric keys found in update_file\",\n  };\n}\n\n// Check required fields exist in the first item\nconst firstItem = updateFile[numericKeys[0]];\nconst missingFields = [];\n\nfor (const field of requiredFields) {\n  if (!(field in firstItem)) {\n    missingFields.push(field);\n  }\n}\n\nif (missingFields.length > 0) {\n  return {\n    isValid: false,\n    message: \"These fields are missing: \" + missingFields.join(\",\"),\n  };\n}\n\nreturn {\n  isValid: true,\n  message: \"All validations passed\",\n};\n"
