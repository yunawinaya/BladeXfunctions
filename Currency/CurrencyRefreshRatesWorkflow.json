    {
      "id": "code_build",
      "type": "code-node",
      "data": {
        "language": "javascript",
        "code": "",
        "timeout": 30000,
        "title": "Build Updates",
        "isValidator": true,
        "nodeName": "Build Updates",
        "name": "Build Updates",
        "script": {
          "type": "javascript",
          "code": "const bnmRows = {{node:api_bnm.data.data}} || [];\nconst orgRows = {{node:search_currency.data.data}} || [];\n\n// Base currency is encoded inconsistently across orgs: \"----\" in some, \"MYR\" in others.\nconst BASE_CODES = [\"----\", \"MYR\", \"RM\", \"\"];\n\nconst byCode = {};\nfor (let i = 0; i < bnmRows.length; i++) {\n  const r = bnmRows[i] || {};\n  const code = String(r.currency_code || \"\").trim().toUpperCase();\n  const unit = Number(r.unit) || 1;\n  const rate = r.rate || {};\n  const mid = rate.middle_rate;\n  if (!code || mid === null || mid === undefined) continue;\n  // BNM quotes weak currencies per 100 units (TWD 12.8643 = 100 TWD). Normalise to per-1.\n  byCode[code] = { rate: Number(mid) / unit, date: rate.date || \"\" };\n}\n\nconst updates = [];\nconst skipped = [];\nconst unmatched = [];\nconst rates = {};\nlet rateDate = \"\";\n\nfor (let i = 0; i < orgRows.length; i++) {\n  const row = orgRows[i] || {};\n  const code = String(row.currency_code || \"\").trim().toUpperCase();\n  if (BASE_CODES.indexOf(code) !== -1) {\n    skipped.push(code || \"(blank)\");\n    continue;\n  }\n  const hit = byCode[code];\n  if (!hit) {\n    unmatched.push(code);\n    continue;\n  }\n  const normalised = hit.rate.toFixed(6);\n  if (Number(normalised) <= 0) {\n    unmatched.push(code + \" (below 6dp)\");\n    continue;\n  }\n  if (!rateDate) rateDate = hit.date;\n  rates[code] = normalised;\n  updates.push({\n    // Keep the snowflake id as a string - it exceeds 2^53 and a bare\n    // JSON number would lose precision if the engine parsed it as a double.\n    id: String(row.id),\n    code: code,\n    buying_rate: normalised,\n    selling_rate: normalised\n  });\n}\n\nlet summary = \"Updated \" + updates.length + \" of \" + orgRows.length + \" currencies\";\nif (rateDate) summary = summary + \" (BNM \" + rateDate + \")\";\nif (unmatched.length) summary = summary + \". No BNM rate: \" + unmatched.join(\", \");\n\nreturn {\n  updates: updates,\n  skipped: skipped,\n  unmatched: unmatched,\n  rates: rates,\n  rate_date: rateDate,\n  summary: summary\n};\n"
        },
