        "language": "javascript",
        "code": "",
        "timeout": 30000,
        "script": {
          "type": "javascript",
          "code": "// PKG_TEST_ADD_HU_ROWS (DEV test tool) - Guard: packing_id, rows (a JSON array of completed HUs), session tenant\nconst s = (v) => (v === undefined || v === null ? \"\" : String(v)).trim();\nconst ID = /^[0-9]{1,20}$/;\nconst guardRows = function guardRows(packingId, rowsIn, tenantId) {\n  const bad = (why) => ({ route: \"REJECT\", tenantId: \"0\", packingId: \"0\", rows: [], result_code: \"400\", result_message: why });\n  if (!ID.test(s(tenantId))) return bad(\"no session tenant\");\n  if (!ID.test(s(packingId))) return bad(\"packing_id: digits only\");\n  let rows = rowsIn;\n  if (typeof rows === \"string\") {\n    try {\n      rows = JSON.parse(rows);\n    } catch (e) {\n      return bad(\"rows is not valid JSON\");\n    }\n  }\n  if (!Array.isArray(rows) || !rows.length || rows.length > 50) return bad(\"rows: 1 to 50 HU rows\");\n  const out = [];\n  for (const r of rows) {\n    if (!r || !ID.test(s(r.handling_unit_id)) || !s(r.handling_no) || !ID.test(s(r.location_id))) return bad(\"each row needs handling_unit_id, handling_no and location_id\");\n    if (s(r.storage_location_id) && !ID.test(s(r.storage_location_id))) return bad(\"storage_location_id: digits only\");\n    let entries = [];\n    try {\n      entries = JSON.parse(s(r.temp_data) || \"[]\");\n    } catch (e) {\n      return bad(\"temp_data of \" + s(r.handling_no) + \" is not valid JSON\");\n    }\n    if (!Array.isArray(entries) || !entries.length) return bad(\"temp_data of \" + s(r.handling_no) + \" is empty\");\n    out.push({ handling_unit_id: s(r.handling_unit_id), handling_no: s(r.handling_no), location_id: s(r.location_id), storage_location_id: s(r.storage_location_id),\n      temp_data: s(r.temp_data), item_count: parseInt(r.item_count, 10) || 0, total_quantity: (parseFloat(r.total_quantity) || 0).toFixed(8) });\n  }\n  return { route: \"CONTINUE\", tenantId: s(tenantId), packingId: s(packingId), rows: out, result_code: \"\", result_message: \"\" };\n};\nconst res = guardRows([{{workflowparams:packing_id}}][0], [{{workflowparams:rows}}][0], [{{system:tenantId}}][0]);\nconsole.log(\"add hu rows guard\", JSON.stringify({ route: res.route, rows: res.rows.length, message: res.result_message }));\nreturn res;"
        },
