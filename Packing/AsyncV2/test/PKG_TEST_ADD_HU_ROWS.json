          "type": "javascript",
          "code": "// PKG_TEST_ADD_HU_ROWS (DEV test tool) - Plan: only a Created Packing with no HU rows; header plant / org / customers\nconst s = (v) => (v === undefined || v === null ? \"\" : String(v)).trim();\nconst planRows = function planRows(guard, factRows) {\n  const f = (Array.isArray(factRows) ? factRows : factRows ? [factRows] : []).filter((r) => r)[0] || {};\n  const bad = (why) => ({ route: \"REJECT\", rows: [], count: 0, result_code: \"400\", result_message: why });\n  if (!s(f.id) || s(f.is_deleted) === \"1\") return bad(\"Packing not found in this tenant\");\n  if (s(f.packing_status) !== \"Created\") return bad(\"the Packing is \" + (s(f.packing_status) || \"not Created\"));\n  if (Number(f.hu_rows) > 0) return bad(\"the Packing already has \" + f.hu_rows + \" HU row(s): nothing added\");\n  // ids kept as digit strings: JSON.parse would round 19-digit ids\n  const customers = s(f.customer_json).match(/[0-9]+/g) || [];\n  const rows = guard.rows.map((r) => ({ packing_id: guard.packingId, plant_id: s(f.plant_id), organization_id: s(f.organization_id), customer_id: customers,\n    handling_no: r.handling_no, handling_unit_id: r.handling_unit_id, hu_row_type: \"generated\", hu_status: \"Completed\", location_id: r.location_id,\n    storage_location_id: r.storage_location_id || null, temp_data: r.temp_data, item_count: r.item_count, total_quantity: r.total_quantity, hu_quantity: 1,\n    hu_material_id: \"\", hu_type: \"\", remark: \"\", remark_2: \"\", remark_3: \"\", parent_hu_id: \"\", select_hu: 0, closed_by: \"PKG_TEST_ADD_HU_ROWS\",\n    net_volume: \"0.000\", gross_weight: \"0.000\", net_weight: \"0.000\" }));\n  return { route: \"ADD\", rows: rows, count: rows.length, result_code: \"\", result_message: \"\" };\n};\nconst res = planRows([{{node:code_node_TAguard.data}}][0], [{{node:sql_node_TAfacts.data}}][0]);\nconsole.log(\"add hu rows plan\", JSON.stringify({ route: res.route, count: res.count, message: res.result_message }));\nreturn res;"
