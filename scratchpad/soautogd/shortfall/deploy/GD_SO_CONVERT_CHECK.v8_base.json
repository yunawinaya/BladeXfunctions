    {
      "id": "code_node_SCresult",
      "type": "code-node",
      "data": {
        "language": "javascript",
        "code": "",
        "timeout": 30000,
        "script": {
          "type": "javascript",
          "code": "// GD_SO_CONVERT_CHECK - Result: the busy sales orders (busy_json: [{so_id, job_id, job_status}]) the asked jobs (jobs_json) and the lost convert run (run_json)\nconst s = (v) => (v === undefined || v === null ? \"\" : String(v)).trim();\nconst asList = (rows) => (Array.isArray(rows) ? rows : rows ? [rows] : []);\nconst seen = {};\nconst busy = [];\nfor (const r of asList([{{node:sql_node_SCbusy.data}}][0]).filter((r) => r && s(r.so_id))) {\n  if (seen[s(r.so_id)]) continue;\n  seen[s(r.so_id)] = true;\n  busy.push({ so_id: s(r.so_id), job_id: s(r.job_id), job_status: s(r.job_status) });\n}\nconst jobs = asList([{{node:sql_node_SCjobs.data}}][0])\n  .filter((r) => r && s(r.job_id))\n  .map((r) => ({ job_id: s(r.job_id), job_status: s(r.job_status), gd_no: s(r.gd_no), error_code: s(r.error_code), error_message: s(r.error_message), error_details: s(r.error_details), command: s(r.command),\n    progress_message: s(r.progress_message) }));\n// the convert run the SO list lost the answer of: the newest run with exactly the asked sales orders (run_json \"null\" while it runs)\nconst want = JSON.parse([{{node:code_node_SCguard.data.runIdsJson}}][0] || \"[]\");\nlet run = null;\nfor (const r of asList([{{node:sql_node_SCrun.data}}][0]).filter((r) => r && s(r.run_id))) {\n  let req = {};\n  try {\n    const o = JSON.parse(s(r.request));\n    req = (o && o.request_json) || o || {};\n  } catch (e) {\n    req = {};\n  }\n  const got = Array.from(new Set((Array.isArray(req.so_ids) ? req.so_ids : []).map(s)));\n  if (got.length !== want.length || want.some((x) => got.indexOf(x) < 0)) continue;\n  let result = null;\n  try {\n    const o = JSON.parse(s(r.response));\n    result = o && o.data && typeof o.data === \"object\" ? o.data : null;\n  } catch (e) {\n    result = null;\n  }\n  run = { run_id: s(r.run_id), status: s(r.status), result: result, error: s(r.error_msg) };\n  break;\n}\nreturn { code: \"200\", message: busy.length ? busy.length + \" sales order(s) still have a delivery saving in the background\" : \"\", busy_json: JSON.stringify(busy), busy_count: String(busy.length),\n  jobs_json: JSON.stringify(jobs), jobs_count: String(jobs.length), run_json: JSON.stringify(run) };"
        },
