                "title": "The SO_AUTO_GD run of a batch whose answer the SO list lost (newest first, its sales orders checked by the result)",
                "isValidator": true,
                "nodeName": "The SO_AUTO_GD run of a batch whose answer the SO list lost (newest first, its sales orders checked by the result)",
                "name": "The SO_AUTO_GD run of a batch whose answer the SO list lost (newest first, its sales orders checked by the result)",
                "script": {
                  "type": "sql",
                  "code": "SELECT CAST(i.id AS CHAR) AS run_id,\n       i.status,\n       LEFT(IFNULL(i.request_json_data, ''), 20000) AS request,\n       LEFT(IFNULL(i.response_json_data, ''), 60000) AS response,\n       LEFT(IFNULL(i.error_msg, ''), 500) AS error_msg\n  FROM su_code_workflow_inst i\n WHERE {{node:code_node_SCguard.data.runSoId}} <> 0\n   AND i.workflow_id = 2076557490389835777\n   AND i.tenant_id = '{{system:tenantId}}'\n   AND i.is_deleted = 0\n   AND i.create_time >= CONVERT_TZ(UTC_TIMESTAMP(), '+00:00', '+08:00') - INTERVAL {{node:code_node_SCguard.data.runSinceS}} SECOND\n   AND i.request_json_data LIKE '%\"{{node:code_node_SCguard.data.runSoId}}\"%'\n ORDER BY i.id DESC\n LIMIT 5"
