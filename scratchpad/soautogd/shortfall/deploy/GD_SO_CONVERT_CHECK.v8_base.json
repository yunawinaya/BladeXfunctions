        "timeout": 30000,
        "script": {
          "type": "javascript",
          "code": "// GD_SO_CONVERT_CHECK - Guard: the sales orders to convert (digits only, at most 500) as a JSON list for the read\nconst s = (v) => (v === undefined || v === null ? \"\" : String(v)).trim();\nconst list = (raw) => Array.from(new Set((Array.isArray(raw) ? raw : s(raw).split(\",\")).map(s).filter((x) => x)));\nconst ids = list([{{workflowparams:so_ids}}][0]);\n// SO_AUTO_GD's V2 deliveries: the SO list follows its queued jobs by id\nconst jobIds = list([{{workflowparams:job_ids}}][0]);\n// a convert batch whose answer the SO list lost: its SO_AUTO_GD run (the batch's sales orders, started at most run_since_s ago)\nconst runIds = list([{{workflowparams:run_so_ids}}][0]);\nconst since = Number(s([{{workflowparams:run_since_s}}][0]) || 600);\nconst bad = ids.concat(jobIds, runIds).filter((x) => !/^[0-9]{1,20}$/.test(x));\nconst why = !ids.length && !jobIds.length && !runIds.length ? \"no sales order ids, job ids or convert run\" : bad.length ? \"ids must be digits\" : ids.length > 500 ? \"at most 500 sales orders per check\" : jobIds.length > 200 ? \"at most 200 jobs per check\" : runIds.length > 50 ? \"at most 50 sales orders per convert run\" : !(since >= 1 && since <= 3600) ? \"run_since_s: 1 to 3600 seconds\" : \"\";\nreturn { route: why ? \"REJECT\" : \"GO\", soIdsJson: JSON.stringify(why ? [] : ids), jobIdsJson: JSON.stringify(why ? [] : jobIds), runSoId: why || !runIds.length ? \"0\" : runIds[0], runIdsJson: JSON.stringify(why ? [] : runIds), runSinceS: String(Math.round(since)), count: String(ids.length), code: why ? \"400\" : \"200\", message: why };"
        },
