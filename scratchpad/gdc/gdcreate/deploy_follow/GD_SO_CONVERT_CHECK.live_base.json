                "nodeName": "The asked GD Created V2 / GD Cancel V2 / GD Revert V2 jobs (tenant-scoped): status, delivery number, error, progress",
                "name": "The asked GD Created V2 / GD Cancel V2 / GD Revert V2 jobs (tenant-scoped): status, delivery number, error, progress",
                "script": {
                  "type": "sql",
                  "code": "SELECT CAST(j.id AS CHAR) AS job_id,\n       j.job_status,\n       IFNULL(j.gd_no, '') AS gd_no,\n       IFNULL(j.error_code, '') AS error_code,\n       LEFT(IFNULL(j.error_message, ''), 500) AS error_message,\n       j.command,\n       LEFT(IFNULL(j.progress_message, ''), 250) AS progress_message\n  FROM JSON_TABLE('{{node:code_node_SCguard.data.jobIdsJson}}', '$[*]' COLUMNS (jid VARCHAR(20) PATH '$')) t\n  JOIN gd_async_job j\n    ON j.id = CAST(t.jid AS UNSIGNED)\n   AND j.tenant_id = '{{system:tenantId}}'\n   AND j.command IN ('CREATE_GD_FROM_FORM', 'CANCEL_GD', 'REVERT_GD')\n   AND j.is_deleted = 0\n LIMIT 200"
