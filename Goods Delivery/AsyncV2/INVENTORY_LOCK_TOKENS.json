                  "code": "// INVENTORY_LOCK_TOKENS - Result (TAKE): every take succeeded - a refused take fails the run before this node\n// Generated by scripts/build-inventory-apply-operation.mjs from scripts/lib/inventory-apply-operation.mjs - edit there.\n// Called only by INVENTORY_APPLY_OPERATION (TAKE, GIVE) and INVENTORY_OPERATION_RECONCILE (GIVE) - lock-protocol.md 8c.\nconst lockTokensResult = function lockTokensResult(guard, plan) {\n  const skipped = plan && Array.isArray(plan.skipped) ? plan.skipped : [];\n  const applied = guard.mode === \"TAKE\" ? guard.count : plan ? Number(plan.plusCount) || 0 : 0;\n  return {\n    mode: guard.mode,\n    operation_id: guard.operationId,\n    requested: guard.count,\n    applied: applied,\n    skipped: JSON.stringify(skipped),\n    result_code: guard.mode === \"TAKE\" ? \"TAKEN\" : skipped.length ? \"GIVEN_WITH_SKIPS\" : \"GIVEN\",\n  };\n};\nconst guard = {\n  mode: [{{node:code_node_YVrnLoAI.data.mode}}][0],\n  operationId: [{{node:code_node_YVrnLoAI.data.operationId}}][0],\n  count: [{{node:code_node_YVrnLoAI.data.count}}][0],\n};\nconst res = lockTokensResult(guard, null);\nconsole.log(\"lock tokens taken\", JSON.stringify(res));\nreturn res;\n"
