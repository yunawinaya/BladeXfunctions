          "code": "// INVENTORY_LOCK_TOKENS - give-back plan: only rows at token 0, owner empty, last owner = this operation\n// Generated by scripts/build-inventory-apply-operation.mjs from scripts/lib/inventory-apply-operation.mjs - edit there.\n// Called only by INVENTORY_APPLY_OPERATION (TAKE, GIVE) and INVENTORY_OPERATION_RECONCILE (GIVE) - lock-protocol.md 8c.\nconst giveBackPlan = function giveBackPlan(guard, rows) {\n  const list = Array.isArray(rows) ? rows : rows ? [rows] : [];\n  const byId = {};\n  for (const r of list) if (r && r.id !== undefined && r.id !== null) byId[String(r.id)] = r;\n  const s = (v) => (v === undefined || v === null ? \"\" : String(v));\n  const plusItems = [];\n  const skipped = [];\n  for (const it of guard.items) {\n    const r = byId[it.id];\n    if (!r) {\n      skipped.push({ id: it.id, reason: \"row not found (deleted, another organization, or not a balance lock)\" });\n      continue;\n    }\n    const t = r.free_token === null || r.free_token === undefined || s(r.free_token).trim() === \"\" ? NaN : Number(r.free_token);\n    if (t !== 0) skipped.push({ id: it.id, lock_key: s(r.lock_key), reason: \"free_token is \" + s(r.free_token) });\n    else if (s(r.owner_operation_id) !== \"\") skipped.push({ id: it.id, lock_key: s(r.lock_key), reason: \"owned by \" + s(r.owner_operation_id) });\n    else if (s(r.last_owner_operation_id) !== guard.operationId) skipped.push({ id: it.id, lock_key: s(r.lock_key), reason: \"last owner is \" + s(r.last_owner_operation_id) });\n    else plusItems.push({ id: it.id, lock_key: s(r.lock_key) });\n  }\n  return { plusItems: plusItems, plusCount: plusItems.length, needPlus: plusItems.length ? \"YES\" : \"NO\", skipped: skipped, skippedCount: skipped.length };\n};\nconst guard = {\n  operationId: [{{node:code_node_YVrnLoAI.data.operationId}}][0],\n  items: [{{node:code_node_YVrnLoAI.data.items}}][0],\n};\nconst res = giveBackPlan(guard, [{{node:sql_node_C2IGFf42.data}}][0]);\nconsole.log(\"give-ba