        "nodeName": "Guard: mode, operation, organization, claimed_at, ids (order kept; a refusal fails the run)",
        "name": "Guard: mode, operation, organization, claimed_at, ids (order kept; a refusal fails the run)",
        "script": {
          "type": "javascript",
          "code": "// INVENTORY_LOCK_TOKENS - Guard: validate the call (read-only)\n// Generated by scripts/build-inventory-apply-operation.mjs from scripts/lib/inventory-apply-operation.mjs - edit there.\n// Called only by INVENTORY_APPLY_OPERATION (TAKE, GIVE) and INVENTORY_OPERATION_RECONCILE (GIVE) - lock-protocol.md 8c.\n// The input comes from the parent's own code nodes: a refusal is an internal inconsistency and FAILS this run\n// (INV_LOCK_TOKENS_INPUT, nothing written), as claimList / verifyClaims do in the parent. The ids keep the parent's\n// order (lock order for TAKE): never re-sorted here. Every value the SQL node interpolates comes from this node (F10, F22).\nconst lockTokensGuard = function lockTokensGuard(input) {\n  const inp = input || {};\n  const str = (v) => (v === undefined || v === null ? \"\" : String(v)).trim();\n  const fail = (msg) => {\n    throw new Error(\"INV_LOCK_TOKENS_INPUT: \" + msg);\n  };\n  const mode = str(inp.mode).toUpperCase();\n  const tenantId = str(inp.systemTenantId);\n  const operationId = str(inp.operationId);\n  const organizationId = str(inp.organizationId);\n  const claimedAt = str(inp.claimedAt);\n  const max = Number(inp.maxLocks);\n  if (mode !== \"TAKE\" && mode !== \"GIVE\") fail(\"mode must be TAKE or GIVE\");\n  if (!/^[0-9]{1,20}$/.test(tenantId)) fail(\"tenant_id is not 1-20 digits\");\n  if (!/^[A-Za-z0-9|:._-]{1,64}$/.test(operationId)) fail(\"operation_id is not 1-64 of A-Z a-z 0-9 | : . _ -\");\n  if (!/^[0-9]{1,19}$/.test(organizationId)) fail(\"organization_id is not 1-19 digits\");\n  if (mode === \"TAKE\" && !/^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$/.test(claimedAt)) fail(\"claimed_at must be YYYY-MM-DD HH:MM:SS for TAKE\");\n  if (mode === \"GIVE\" && claimedAt !== \"\") fail(\"claimed_at must be empty for GIVE\");\n  if (!Array.isArray(inp.ids) || !inp.ids.length) fail(\"ids must be a non-empty array\");\n  if (!(max > 0)) fail(\"no lock bound\");\n  if (inp.ids.length > max) fail(\"ids has \" + inp.ids.length + \" entries, more than the \" + max + \" locks one operation can hold\");\n  const seen = {};\n  const items = [];\n  for (let i = 0; i < inp.ids.length; i++) {\n    const raw = inp.ids[i];\n    if (typeof raw !== \"string\" || !/^[0-9]{1,20}$/.test(raw)) fail(\"ids[\" + i + \"] is not a string of 1-20 digits\");\n    if (seen[raw]) fail(\"ids[\" + i + \"] \" + raw + \" is listed twice\");\n    seen[raw] = true;\n    items.push({ id: raw });\n  }\n  return {\n    mode: mode,\n    tenantId: tenantId,\n    operationId: operationId,\n    organizationId: organizationId,\n    claimedAt: mode === \"TAKE\" ? claimedAt : \"\",\n    items: items,\n    count: items.length,\n    idListSql: items.map((x) => x.id).join(\",\"),\n    one: 1,\n  };\n};\n// derived bound, not a new one: every effect locks its balance key, a BATCH effect also its ITEM aggregate key\n// (2 x contract request.max_effects = 40000)\nconst MAX_LOCKS = 40000;\n// The array wrapper survives a param that arrives empty.\nconst res = lockTokensGuard({\n  mode: [{{workflowparams:mode}}][0],\n  operationId: [{{workflowparams:operation_id}}][0],\n  organizationId: [{{workflowparams:organization_id}}][0],\n  claimedAt: [{{workflowparams:claimed_at}}][0],\n  ids: [{{workflowparams:ids}}][0],\n  systemTenantId: [{{system:tenantId}}][0],\n  maxLocks: MAX_LOCKS,\n});\nconsole.log(\"lock tokens guard\", JSON.stringify({ mode: res.mode, operationId: res.operationId, count: res.count }));\nreturn res;\n"
        },
