    {
      "id": "sql_node_SCbusy",
      "type": "sql-node",
      "data": {
        "database_id": "",
        "sql": "",
        "params": {},
        "title": "Unfinished background saves (CREATE_GD_FROM_FORM) delivering one of the sales orders",
        "isValidator": true,
        "nodeName": "Unfinished background saves (CREATE_GD_FROM_FORM) delivering one of the sales orders",
        "name": "Unfinished background saves (CREATE_GD_FROM_FORM) delivering one of the sales orders",
        "script": {
          "type": "sql",
          "code": "SELECT t.sid AS so_id,\n       CAST(j.id AS CHAR) AS job_id,\n       j.job_status\n  FROM JSON_TABLE('{{node:code_node_SCguard.data.soIdsJson}}', '$[*]' COLUMNS (sid VARCHAR(20) PATH '$')) t\n  JOIN gd_async_job j\n    ON j.tenant_id = '{{system:tenantId}}'\n   AND j.command = 'CREATE_GD_FROM_FORM'\n   AND j.is_deleted = 0\n   AND j.job_status IN ('QUEUED', 'VALIDATING', 'CALCULATING', 'READY_TO_COMMIT', 'COMMITTING_GD', 'RECONCILING_GD', 'REQUIRES_REVIEW')\n   AND j.source_so_ids LIKE CONCAT('%\"', t.sid, '\"%') COLLATE utf8mb4_general_ci\n ORDER BY t.sid, j.id\n LIMIT 500"
        },
